# Loaded by the backend with dotenvy. Copy to backend/.env and fill in. Never commit .env.
# The DB_* values are all the backend needs: the server, `cargo run -- migrate` and the
# database tests build the MySQL connection from them (no DATABASE_URL).

# ---------- App ----------
APP_ENV=development              # development | production (production => Secure cookies)
BACKEND_HOST=127.0.0.1           # interface to bind
BACKEND_PORT=8080                # port to listen on
FRONTEND_URL=http://localhost:5173   # used for CORS (the only allowed origin)

# ---------- MySQL ----------
DB_HOST=                         # e.g. 127.0.0.1
DB_PORT=3306                     # MySQL port
DB_NAME=gic_review               # database name
DB_USER=                         # database user
DB_PASSWORD=                     # database password
DB_SSL_REQUIRED=false           # true = the MySQL connection must use SSL (e.g. cloud databases)

# ---------- Auth ----------
JWT_SECRET=                      # long random string (e.g. openssl rand -hex 64), min 32 chars
JWT_EXPIRES_IN_HOURS=12          # session lifetime
ADMIN_EMAIL=                     # first admin, created on first start if none exists
ADMIN_PASSWORD=                  # change after first login (min 8 chars)

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=                   # Cloudflare account id
R2_ACCESS_KEY_ID=                # R2 API token access key id
R2_SECRET_ACCESS_KEY=            # R2 API token secret
R2_BUCKET=gic-review             # bucket name
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com   # S3 API endpoint
R2_PUBLIC_BASE_URL=              # public bucket domain, e.g. https://files.example.com (no trailing slash)

# ---------- Upload limits ----------
MAX_IMAGE_SIZE_MB=5              # max size of one uploaded image
MAX_REVIEW_HTML_SIZE_MB=10       # max size of one interactive review .html file
