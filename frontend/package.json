{
  "name": "gic-review-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ vite/ vite.config.ts eslint.config.js",
    "format:check": "prettier --check src/ vite/ vite.config.ts eslint.config.js",
    "type-check": "vue-tsc -b"
  },
  "dependencies": {
    "@catppuccin/palette": "^1.8.0",
    "@mdi/font": "^7.4.47",
    "animate.css": "^4.1.1",
    "aos": "^2.3.4",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vuetify": "^4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/aos": "^3.0.8",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plugin-webfont-dl": "^3.14.1",
    "vue-tsc": "^3.3.14"
  }
}
